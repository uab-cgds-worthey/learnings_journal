# pipeline
function status_smvp() {
    find "$SMVP_LOGS_DIR" -maxdepth 1 -name "*.err" -mtime -$1 -print0 | xargs -0 /data/project/worthey_lab/tools/pipeline-status-scripts/pretty_status_snakemake_pipeline.sh
}

