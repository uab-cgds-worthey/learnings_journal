# pipeline functions/aliases

# find all gubernomics stderr log files modified within the last n days (n is a user supplied number)
# and pass their SLURM Job ID(s) to sacct to display status of gubernomics pipeline runs
# example usage: guberstat 1
guberstat() {
    find "${LAB}/projects/production_pipelines/logs/gubernomics" -maxdepth 1 -name "*.err" -mtime -"$1" -print0 | xargs -0 -I {} basename {} | cut -d'.' -f5 | paste -sd, | xargs -I {} sacct --format="JobID,JobName%30,Ntasks,MaxRSS,Elapsed,state%20,NodeList,Partition%30,AllocTRES%40" --units=G -j {}
}

# find all SLURM Job IDs a snakemake pipeline has submitted (parsed from pipeline's stderr log file)
# and pass their SLURM Job IDs to sacct to display status of all SLURM jobs submitted by pipeline
# example usage: snakestat ${LAB}/projects/production_pipelines/logs/gubernomics/GUBERNOMICS-2026-07-20T10.11.31.056543.39421886.err
snakestat() {
    awk 'BEGIN{idlist = ""}{if (match($0, /Job ([0-9]+) has been submitted with SLURM jobid ([0-9]+)/, arr) || match($0, /Submitted job ([0-9]+) with external jobid \047([0-9]+)\047./, arr)) { if(idlist == ""){idlist = arr[2]}else{idlist = idlist "," arr[2] }}} END{ print idlist}' "$1" | xargs -I {} sacct --format="JobID,JobName%30,Ntasks,MaxRSS,Elapsed,state%20,NodeList,Partition%30,AllocTRES%40" --units=G -j {}
}

function status_svp() {
    find "$SVP_LOGS_DIR" -maxdepth 1 -name "*.err" -mtime -$1 -print0 | xargs -0 ${LAB}/tools/pipeline-status-scripts/pretty_status_snakemake_pipeline.sh
}

